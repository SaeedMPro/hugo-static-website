{{/* صفحهٔ هر حوزهٔ پژوهشی از فایل‌های data/areas ساخته می‌شود. */}}
{{ $lang := .Site.Language.Lang }}
{{ range $id, $a := .Site.Data.areas }}
  {{ $.AddPage (dict
    "path" $id
    "title" (index $a (printf "title_%s" $lang))
    "kind" "page"
    "weight" ($a.weight | default 99)
    "content" (dict "mediaType" "text/markdown" "value" (index $a (printf "body_%s" $lang) | default ""))
    "params" (merge $a (dict "pid" $id))
  ) }}
{{ end }}
